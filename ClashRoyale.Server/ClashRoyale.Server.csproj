<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>ClashRoyale.Program</StartupObject>
    <RootNamespace>ClashRoyale</RootNamespace>
    <AssemblyName>ClashRoyale.Server</AssemblyName>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClashRoyale\ClashRoyale.csproj" />
    <ProjectReference Include="..\ClashRoyale.Patcher\ClashRoyale.Patcher.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Secrets\pepper.key" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Build the Patcher as a companion tool, without linking it into the server. -->
  <Target Name="CollectPatcherArtifacts" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="../ClashRoyale.Patcher/ClashRoyale.Patcher.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_PatcherTarget" />
    </MSBuild>
    <ItemGroup>
      <_PatcherArtifact Include="%(_PatcherTarget.RootDir)%(_PatcherTarget.Directory)ClashRoyale.Patcher.*" />
    </ItemGroup>
  </Target>
  <Target Name="CopyPatcherToBuild" AfterTargets="Build" DependsOnTargets="CollectPatcherArtifacts">
    <Copy SourceFiles="@(_PatcherArtifact)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="@(_PatcherArtifact->'$(TargetDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
  <Target Name="IncludePatcherInPublish" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="CollectPatcherArtifacts">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_PatcherArtifact)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
